# Django
DJANGO_SECRET_KEY=replace-with-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default for quick local run; set USE_POSTGRES=True for PostgreSQL + pgvector)
USE_POSTGRES=False
POSTGRES_DB=refit
POSTGRES_USER=refit
POSTGRES_PASSWORD=refit_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Channels / Celery
REDIS_URL=redis://localhost:6379/0

# SSAFY GMS AI Gateway (NEVER commit real keys!)
GMS_API_KEY=your-ssafy-gms-api-key
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_CHAT_MODEL=gpt-4o-mini
GMS_VISION_MODEL=gpt-4o
GMS_EMBEDDING_MODEL=text-embedding-3-small
GMS_IMAGE_MODEL=dall-e-3
AI_MOCK_MODE=False

# Test PG (PortOne / Toss Payments Sandbox)
PG_PROVIDER=PORTONE_TEST
PG_API_KEY=your-test-pg-api-key
PG_API_SECRET=your-test-pg-api-secret
